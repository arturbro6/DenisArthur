<Page x:Class="MathMenu.pages.OdeSolve"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MathMenu.pages"
      xmlns:controls="clr-namespace:MathMenu.controls"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="1100"
      Title="OdeSolve">

    <Page.Resources>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFE8E8E8"/>
            <Setter Property="BorderBrush" Value="#FFC0C0C0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid Background="LightGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="300"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Name="BackButt" Click="BackButt_Click" Grid.Column="0" Grid.Row="0" Height="24" Width="70"
                HorizontalAlignment="Left" VerticalAlignment="Top" Content="назад" Margin="20,20,0,0"/>

        <Label Name="L1" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="27"
               Content="Метод Эйлера"/>

        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" VerticalScrollBarVisibility="Auto" KeyDown="Inputs_KeyDown"
                      Margin="20,0,10,20">
            <StackPanel>
                <Label Content="тип задачи:" Padding="0" FontSize="12"/>
                <ComboBox Name="TypeBox" Height="28" SelectionChanged="TypeBox_SelectionChanged">
                    <ComboBoxItem Name="Ode1Item" Content="ОДУ 1-го порядка"/>
                    <ComboBoxItem Name="Ode2Item" Content="ОДУ 2-го порядка"/>
                    <ComboBoxItem Name="Ode3Item" Content="система трёх уравнений"/>
                </ComboBox>

                <Label Content="численный метод:" Padding="0" FontSize="12" Margin="0,8,0,0"/>
                <ComboBox Name="MethodBox" Height="28" SelectionChanged="MethodBox_SelectionChanged">
                    <ComboBoxItem Name="EulerItem" Content="метод Эйлера"/>
                    <ComboBoxItem Name="RungeItem" Content="метод Рунге-Кутта"/>
                </ComboBox>

                <Border Background="#FFF7F7F7" BorderBrush="#FFB0B0B0" BorderThickness="1" Margin="0,10,0,6"
                        Padding="6">
                    <TextBlock Name="EquationText" FontSize="13" TextWrapping="Wrap" FontStyle="Italic"/>
                </Border>

                <Label Name="X0Label" Content="x₀:" Padding="0" FontSize="12"/>
                <TextBox Name="X0Box" Height="26"/>

                <Label Name="XEndLabel" Content="конечное значение x:" Padding="0" FontSize="12" Margin="0,6,0,0"/>
                <TextBox Name="XEndBox" Height="26"/>

                <Label Name="HLabel" Content="шаг h:" Padding="0" FontSize="12" Margin="0,6,0,0"/>
                <TextBox Name="HBox" Height="26"/>

                <Label Name="U0Label" Content="y₀:" Padding="0" FontSize="12" Margin="0,6,0,0"/>
                <TextBox Name="U0Box" Height="26"/>

                <Label Name="V0Label" Content="y′₀:" Padding="0" FontSize="12" Margin="0,6,0,0"/>
                <TextBox Name="V0Box" Height="26"/>

                <Label Name="W0Label" Content="z₀:" Padding="0" FontSize="12" Margin="0,6,0,0"/>
                <TextBox Name="W0Box" Height="26"/>

                <Button Name="CalcButt" Content="вычислить" Height="32" Margin="0,14,0,0" Click="CalcButt_Click"/>
                <Button Name="ResetButt" Content="начальные данные по заданию" Height="26" Margin="0,6,0,0"
                        FontSize="12" Click="ResetButt_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,20,10"
                Background="White" BorderBrush="#FFA8A8A8" BorderThickness="1" SizeChanged="PlotArea_SizeChanged">
            <Image Name="PlotImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Name="InfoLabel" Grid.Row="0" FontSize="12" Margin="0,0,0,4"
                       TextWrapping="Wrap" Foreground="#FF4A4A4A"/>

            <TabControl Grid.Row="1" FontSize="12">
                <TabItem Header="Таблица значений">
                    <DataGrid Name="MainGrid" AutoGenerateColumns="True" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" Background="White" RowBackground="White"
                              AlternatingRowBackground="#FFF2F2F2" FontSize="12" ColumnWidth="auto" RowHeight="22"
                              ColumnHeaderStyle="{StaticResource GridHeader}"/>
                </TabItem>
                <TabItem Header="Сравнение методов">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="4,4,4,6" FontSize="12" TextWrapping="Wrap"
                                   Foreground="#FF4A4A4A"
                                   Text="Метод Эйлера при шаге h, h/10, h/100, h/1000 и метод Рунге-Кутта при h/2. Видно, как решение Эйлера сходится к решению Рунге-Кутта при уменьшении шага (п. 3.4 и 7.1 задания)."/>
                        <DataGrid Grid.Row="1" Name="CmpGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" Background="White" RowBackground="White"
                                  AlternatingRowBackground="#FFF2F2F2" FontSize="12" ColumnWidth="auto" RowHeight="22"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>



