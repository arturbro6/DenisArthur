<Page x:Class="MathMenu.pages.main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MathMenu.pages"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="1100"
      Title="main">

    <Grid Background="LightGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Label Grid.ColumnSpan="4" Content="Математическое меню" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" />

        <Button x:Name="DigitInteg"
            Margin="0,10,0,10" Content="Чис. Интегрирование"
            Grid.Row="1" Grid.Column="1" Height="40" Width="170" Click="DigitInteg_Click" />
        <Button x:Name="DiffUrav" Grid.Row="1"
            Grid.Column="2"
            Margin="0,10,0,10"
            Content="Дифф. Уравнения"
            Height="40"
            Width="170"
            Click="DiffUrav_Click" />

        <!-- выбор шага и метода для численного интегрирования -->
        <StackPanel x:Name="DigitPanel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center" Margin="0,10,0,10" Visibility="Collapsed">
            <Label Name="StepLabel" Content="выберите способ задания шага" HorizontalAlignment="Center" />
            <ComboBox Name="DigitBox" Height="32" Width="280" SelectionChanged="DigitBox_SelectionChanged">
                <ComboBoxItem Name="StepChoose" Content="— не выбрано —" />
                <ComboBoxItem Name="ConstVar" Content="постоянный шаг" />
                <ComboBoxItem Name="MovingVar" Content="переменный шаг" />
            </ComboBox>

            <Label Name="DBLabel" Content="выберите метод вычисления" Visibility="Collapsed"
                   HorizontalAlignment="Center" Margin="0,8,0,0" />
            <ComboBox Name="MethodBox" Height="32" Width="300" Visibility="Collapsed"
                      SelectionChanged="MethodBox_SelectionChanged" />
        </StackPanel>

        <!-- выбор типа уравнения и метода для дифференциальных уравнений -->
        <StackPanel x:Name="OdePanel" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center" Margin="0,5,0,10" Visibility="Collapsed">
            <Label Name="TypeLabel" Content="выберите тип уравнения" HorizontalAlignment="Center" />
            <ComboBox Name="TypeBox" Height="32" Width="280" SelectionChanged="TypeBox_SelectionChanged">
                <ComboBoxItem Name="TypeChoose" Content="— не выбрано —" />
                <ComboBoxItem Name="Ode1Item" Content="ОДУ 1-го порядка" />
                <ComboBoxItem Name="Ode2Item" Content="ОДУ 2-го порядка" />
                <ComboBoxItem Name="Ode3Item" Content="система трёх уравнений" />
            </ComboBox>

            <Label Name="OdeLabel" Content="выберите метод вычисления" Visibility="Collapsed"
                   HorizontalAlignment="Center" Margin="0,8,0,0" />
            <ComboBox Name="OdeMethodBox" Height="32" Width="280" Visibility="Collapsed"
                      SelectionChanged="OdeMethodBox_SelectionChanged">
                <ComboBoxItem Name="MethodChoose" Content="— не выбрано —" />
                <ComboBoxItem Name="EulerItem" Content="метод Эйлера" />
                <ComboBoxItem Name="RungeItem" Content="метод Рунге-Кутта" />
            </ComboBox>
        </StackPanel>

        <Label Grid.Row="4" Grid.ColumnSpan="4" x:Name="HintLabel"
               Content="выберите пункт меню, затем способ вычисления"
               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
               Foreground="#FF5A5A5A" FontSize="13" />
    </Grid>
</Page>
