# Пример для отдельного репозитория: package.json и app находятся в его корне.
# Здесь это учебный файл, workflow не активирован.
name: Publish lab
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: true
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
      - run: npm ci
      - run: npm run build
      - name: Check files
        run: |
          test -f app/index.html
          test -f app/dist/styles.css
          test -f app/dist/bundle.js
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v4
        with:
          path: app
      - uses: actions/deploy-pages@v4
        id: deployment
